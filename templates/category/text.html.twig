{% extends 'base.html.twig' %}

{% block title %}
    {{ category.titre }}
{% endblock %}

{% block meta %}
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="description" content="Caroline MARCELLIER, {{ category.titre }}"/>
    <meta name="author" content="Caroline MARCELLIER"/>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/categories.css', 'static_assets') }}">
{% endblock %}

{% block body %}
    <div class="page-content category-page">
        <div class="category-page__inner">
            <h2 class="category-page__title">{{ category.titre }}</h2>

            {% if category.contenu %}
                <div class="category-text">
                    {{ category.contenu|raw }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
