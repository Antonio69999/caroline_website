{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/categories.css', 'static_assets') }}">
    <link rel="stylesheet" href="{{ asset('asset/css/category_text.css', 'static_assets') }}">
{% endblock %}

{% block body %}
    <div class="page-content category-page">
        <div class="category-page__inner">
            <h1 class="category-page__title">{{ category.titre }}</h1>

            {% if category.contenu %}
                <div class="category-text">
                    {{ category.contenu|raw }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
