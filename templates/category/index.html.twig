{% extends 'base.html.twig' %}

{% block title %}
    {% for category in categories %}
        <title>{{ category.titre }}</title>
    {% endfor %}
{% endblock %}

{% block meta %}
    {% for article in articles %}
        <meta name="description" content="{{ article.titre }}"/>
    {% endfor %}
    <meta name="author" content="Caroline MARCELLIER"/>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/simplelightbox.min.css', 'static_assets') }}">
{% endblock %}

{% block body %}
    <div class="page-content">
        {% for article in articles %}
            <div class="article-detail">
                <div class="gallery">
                    {% for media in article.media %}
                        <a href="{{ asset('uploads/attachments/' ~ media.imageName) }}" title="Caption for gallery item 1">
                            <img src="{{ asset('uploads/attachments/' ~ media.imageName) }}" alt="{{ media.imageName }}">
                        </a>
                    {% endfor %}
                </div>

                <div class="description">
                    <h2 class="article_subtitle">{{ article.titre }}</h2>
                    <p>{{ article.description|raw }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="{{ asset('asset/js/simple-lightbox.min.js', 'static_assets') }}"></script>
    <script>
        (function () {
            var $gallery = new SimpleLightbox('.gallery a', {});
        })();
    </script>

{% endblock %}

    {% block footer %}{% endblock %}
