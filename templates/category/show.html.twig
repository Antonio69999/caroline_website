{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/categories.css', 'static_assets') }}">
{% endblock %}

{% block body %}
    <div class="page-content category-page">
        <div class="category-page__inner">
            <h1 class="category-page__title">{{ category.titre }}</h1>

            <div class="category-grid">
                {% for article in articles %}
                    {% if article.media|length > 0 %}
                        {% set randomImage = random(article.media) %}

                        <a
                            class="category-card"
                            href="{{ article_path(article) }}"
                        >
                            {# Les premières vignettes sont visibles tout de suite ; les autres ne se chargent qu'en défilant #}
                            <img
                                class="category-card__image"
                                src="{{ thumb_url(randomImage.imageName) }}"
                                alt="{{ randomImage.legende ?: article.titre }}"
                                {% if loop.index > 6 %}loading="lazy"{% endif %}
                                decoding="async"
                            >

                            <span class="category-card__overlay">
                                <span class="category-card__title">
                                    {{ article.titre }}
                                </span>
                            </span>
                        </a>
                    {% endif %}
                {% endfor %}
            </div>

            {% if category.description %}
                {# Même règle que la description d'un article (voir textes.css) #}
                <div class="category-page__description{{ texte_est_long(category.description) ? ' category-page__description--longue' }}">
                    {{ category.description|texte_propre }}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block footer %}{% endblock %}
