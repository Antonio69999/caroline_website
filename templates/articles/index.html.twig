{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('asset/css/simplelightbox.min.css', 'static_assets') }}">
    {# Après simplelightbox.min.css : remplace son bandeau gris par un nom discret sous la photo #}
    <link rel="stylesheet" href="{{ asset('asset/css/lightbox.css', 'static_assets') }}">
{% endblock %}

{% block body %}

    <div class="narrow-content article-page">
        <div class="article-detail">
            <h1 class="article_subtitle">{{ article.titre }}</h1>
            <div class="gallery">
                {% for media in article.media %}
                    {# Le clic ouvre la photo d'origine en grand ; la page, elle, n'affiche que sa vignette #}
                    <a href="{{ asset('uploads/attachments/' ~ media.imageName) }}" title="{{ media.legende }}">
                        <img
                            src="{{ thumb_url(media.imageName) }}"
                            alt="{{ media.legende ?: article.titre }}"
                            title="{{ media.legende }}"
                            {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                            decoding="async"
                        >
                    </a>
                {% endfor %}
            </div>
            {# Pas de <p> autour : l'éditeur de l'admin écrit des <div>, et un <div> dans un <p> fait
               « casser » le paragraphe par le navigateur (le texte sortait du <p> et de sa police). #}
            <div class="description">
                {{ article.description|raw }}
            </div>

            {# Lien vers la catégorie, en bas de l'article : aide les visiteurs à remonter, et relie la page au reste du site pour Google #}
            {% if article.categorie and article.categorie.titre %}
                <nav class="breadcrumb" aria-label="Fil d'Ariane">
                    <a href="{{ category_path(article.categorie) }}">&larr; {{ article.categorie.titre }}</a>
                </nav>
            {% endif %}
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="{{ asset('asset/js/simple-lightbox.min.js', 'static_assets') }}"></script>
    <script>
        (function () {
            var $gallery = new SimpleLightbox('.gallery a', {
                showCounter: false,
            });
        })();
    </script>

{% endblock %}


    {% block footer %}{% endblock %}
