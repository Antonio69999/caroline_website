<!DOCTYPE html>
<html>
    <head>
        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-WF4S4Q7K');</script>
        <!-- End Google Tag Manager -->
        <link rel="icon" type="image/x-icon" href="{{ asset('asset/krot.gif', 'static_assets') }}"/>
        <link rel="shortcut icon" type="image/png" href="{{ asset('asset/images/logo.png', 'static_assets') }}"/>
        <link rel="apple-touch-icon" href="{{ asset('asset/images/logo.png', 'static_assets') }}"/>
        {% block head %}{% endblock %}
        <meta charset="utf-8">
        <title>
            {% block title %}Welcome!
            {% endblock %}
        </title>
        <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport"> {% block meta %}{% endblock %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block og_meta %}
            <meta property="og:title" content="Bienvenue dans mon jardin">
            <meta property="og:type" content="website"/>
            <meta property="og:image" content="{{ asset('asset/images/auberge.jpeg', 'static_assets') }}">
            <meta property="og:url" content="https://carottecake.com/">
            <meta name="twitter:card" content="summary_large_image">
            <meta name="twitter:image" content="{{ asset('asset/images/auberge.jpeg', 'static_assets') }}">
            <meta property="og:description" content="Peintures, gravures, ateliers participatifs">
            <meta property="og:site_name" content="Caroline Marcellier">
            <meta name="twitter:image:alt" content="Caroline Marcellier auberge">
            <meta property="fb:app_id" content=""/>
            <meta name="twitter:site" content="@caroline-marceliier">
        {% endblock %}
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WF4S4Q7K"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        {% include '/components/menu.html.twig' %}
        {% block body %}{% endblock %}
        {% block footer %}
            {# {% include 'components/footer.html.twig' %} #}
        {% endblock %}
    </body>
</html>
