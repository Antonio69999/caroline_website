<!DOCTYPE html>
{# Le site est déjà en français : on interdit la traduction automatique du navigateur.
   Sinon Chrome/Edge « traduisent » le français en français, en remplaçant au passage les polices du site.
   Trois signaux pour couvrir tous les navigateurs : l'attribut standard translate="no", la classe
   notranslate (Google Traduction) et la balise meta google. #}
<html lang="fr" translate="no" class="notranslate">
    <head>
        <meta charset="utf-8">
        <meta name="google" content="notranslate">
        {# Le zoom au pincement reste permis (accessibilité, et on veut pouvoir regarder une œuvre de près) #}
        <meta content="width=device-width, initial-scale=1" name="viewport">
        <title>{% block title %}{{ seo is defined ? seo.title : 'Caroline Marcellier' }}{% endblock %}</title>
        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-WF4S4Q7K');</script>
        <!-- End Google Tag Manager -->
        <link rel="icon" type="image/x-icon" href="{{ asset('asset/krot.gif', 'static_assets') }}"/>
        <link rel="shortcut icon" type="image/png" href="{{ asset('asset/images/logo.png', 'static_assets') }}"/>
        <link rel="apple-touch-icon" href="{{ asset('asset/images/logo.png', 'static_assets') }}"/>
        {% block head %}{% endblock %}
        <meta name="author" content="Caroline MARCELLIER"/>
        {#
            Référencement : tout vient de l'objet « seo » que fabrique App\Seo\SeoBuilder pour chaque
            page publique. Une page qui n'en fournit pas (connexion, erreurs…) reste hors de Google.
        #}
        {% block meta %}
            {% if seo is defined %}
                <meta name="description" content="{{ seo.description }}"/>
                <meta name="robots" content="{{ seo.robots }}"/>
                {# Demande aux robots d'IA de ne pas utiliser les textes et images pour s'entraîner. Dans une balise à part :
                   Google ne connaît pas ces mots et les ignore, sans effet sur le reste des consignes. #}
                <meta name="robots" content="noai, noimageai"/>
                <link rel="canonical" href="{{ seo.canonical }}"/>
                {{ seo_json_ld(seo) }}
            {% else %}
                <meta name="robots" content="noindex, nofollow"/>
            {% endif %}
        {% endblock %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="stylesheet" href="{{ asset('asset/css/seo.css', 'static_assets') }}">
        {% block stylesheets %}{% endblock %}
        {% block og_meta %}
            {% if seo is defined %}
                <meta property="og:site_name" content="Caroline Marcellier">
                <meta property="og:locale" content="fr_FR">
                <meta property="og:type" content="website"/>
                <meta property="og:title" content="{{ seo.title }}">
                <meta property="og:description" content="{{ seo.description }}">
                <meta property="og:url" content="{{ seo.canonical }}">
                <meta property="og:image" content="{{ seo.image }}">
                <meta property="og:image:alt" content="{{ seo.imageAlt }}">
                <meta name="twitter:card" content="summary_large_image">
                <meta name="twitter:title" content="{{ seo.title }}">
                <meta name="twitter:description" content="{{ seo.description }}">
                <meta name="twitter:image" content="{{ seo.image }}">
                <meta name="twitter:image:alt" content="{{ seo.imageAlt }}">
            {% endif %}
        {% endblock %}
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WF4S4Q7K"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        {% include '/components/menu.html.twig' %}
        {% block body %}{% endblock %}
        {# Easter egg de la petite carotte (hors page de connexion, qui le désactive) #}
        {% block easter_egg %}{% include 'components/easter_egg.html.twig' %}{% endblock %}
        {% block footer %}
            {# {% include 'components/footer.html.twig' %} #}
        {% endblock %}
    </body>
</html>
