<button
    type="button"
    id="menuToggle"
    class="fixed top-4 left-4 z-[110] flex h-11 w-11 items-center justify-center rounded-md border border-gray-200 bg-white shadow-sm md:hidden"
    aria-expanded="false"
    aria-controls="main-menu"
    aria-label="Ouvrir le menu"
>
    <svg id="menuIconOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>

    <svg id="menuIconClose" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
</button>

<div id="menuBackdrop" class="fixed inset-0 z-[90] hidden bg-black/40 md:hidden"></div>

<nav
    id="main-menu"
    class="menu fixed inset-y-0 left-0 z-[100] w-[250px] -translate-x-full border-r border-gray-200 bg-white transition-transform duration-300 ease-in-out md:translate-x-0"
    aria-label="Navigation principale"
>
    <ul>
        <li>
            <a href="{{ path('app_home') }}" aria-label="Retour à l'accueil">
                <div class="logo" aria-hidden="true"></div>
            </a>
        </li>

        <li id="name" class="box-border px-2.5">
            <button type="button" id="myBtn">
                <h1 class="caroline" id="openModal">Caroline MARCELLIER</h1>
            </button>
        </li>

        <li class="box-border px-2.5">
            <a
                class="block h-10 text-lg leading-10 transition-all duration-300 hover:border-b hover:border-gray-300"
                href="{{ path('preambule') }}"
                target="_blank"
                rel="noopener noreferrer"
            >
                Préambule
            </a>
        </li>

        {% for category in categories %}
            <li class="box-border px-2.5">
                <a
                    class="block h-10 text-lg leading-10 transition-all duration-300 hover:border-b hover:border-gray-300"
                    href="{{ path('app_category_show', {'id': category.id}) }}"
                >
                    {{ category.titre }}
                </a>
            </li>
        {% endfor %}

        <li class="box-border px-2.5">
            <a
                class="block h-10 text-lg leading-10 transition-all duration-300 hover:border-b hover:border-gray-300"
                href="{{ path('contact') }}"
            >
                Contact
            </a>
        </li>
    </ul>
</nav>

<div id="myModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="recipeTitle">
    <div class="modal-content">
        <button type="button" class="close" aria-label="Fermer la recette">&times;</button>

        <p id="recipeTitle" class="carrot-title">Carotte Cake<br></p>
        <p class="carrot-ingredient">Ingrédients :</p>

        <p>
            150g de sucre roux<br>
            3 œufs de poules élevées à ma borie<br>
            150ml d’huile d’olive goût à l’ancienne<br>
            200g de farine<br>
            2 cuillères à café de levure<br>
            1 cuillère à café de cannelle<br>
            1/2 cuillère à café de muscade<br>
            1 pincée de sel<br>
            350g de carottes râpées<br>
            80g de noix coupées en morceaux<br><br>
        </p>

        <p class="carrot-ingredient">Glaçage :</p>
        <p>
            200g de cream cheese<br>
            80g de sucre glace<br>
            2 c. à soupe d’huile d’olive goût à l’ancienne<br>
            1/2 zeste de citron<br><br>
        </p>

        <p class="carrot-ingredient">Préparation :</p>
        <p>
            Préchauffer le four à 170°C<br>
            Fouetter au fouet électrique le sucre et les œufs jusqu’à obtenir un mélange bien blanc et volumineux.<br>
            Ajouter alors l’huile d’olive en filet tout en fouettant.<br>
            Fouetter encore 20 secondes pour bien mélanger.<br>
            Mélanger la farine avec la levure, les épices, le sel.<br>
            Ajouter les carottes râpées et les noix, mélanger puis incorporer le mélange aux œufs.<br>
            Mélanger délicatement à la spatule.<br>
            Verser dans un moule huilé et faire cuire 40 à 45 minutes.<br>
            Laisser complètement refroidir sur une grille.<br>
            Préparer le glaçage en fouettant le fromage frais avec le sucre, l’huile d’olive et le zeste, jusqu’à obtenir un mélange lisse et homogène.
        </p>

        <p>Étaler sur le dessus du gâteau.</p>
    </div>
</div>

<script>
(function () {
    const toggle = document.getElementById('menuToggle');
    const panel = document.getElementById('main-menu');
    const backdrop = document.getElementById('menuBackdrop');
    const iconOpen = document.getElementById('menuIconOpen');
    const iconClose = document.getElementById('menuIconClose');

    function setMenuOpen(isOpen) {
        if (!toggle || !panel || !backdrop || !iconOpen || !iconClose) {
            return;
        }

        panel.classList.toggle('-translate-x-full', !isOpen);
        backdrop.classList.toggle('hidden', !isOpen);
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
    }

    if (toggle && panel && backdrop) {
        toggle.addEventListener('click', function () {
            setMenuOpen(panel.classList.contains('-translate-x-full'));
        });

        backdrop.addEventListener('click', function () {
            setMenuOpen(false);
        });

        panel.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
                if (window.innerWidth < 768) {
                    setMenuOpen(false);
                }
            });
        });
    }

    const modal = document.getElementById('myModal');
    const modalButton = document.getElementById('myBtn');
    const modalClose = modal ? modal.querySelector('.close') : null;

    function setModalOpen(isOpen) {
        if (!modal) {
            return;
        }

        modal.style.display = isOpen ? 'block' : 'none';
    }

    if (modalButton) {
        modalButton.addEventListener('click', function () {
            setModalOpen(true);
        });
    }

    if (modalClose) {
        modalClose.addEventListener('click', function () {
            setModalOpen(false);
        });
    }

    window.addEventListener('click', function (event) {
        if (event.target === modal) {
            setModalOpen(false);
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') {
            return;
        }

        setMenuOpen(false);
        setModalOpen(false);
    });
})();
</script>
