<button type="button"
        id="menuToggle"
        class="fixed top-4 left-4 z-[110] flex h-11 w-11 items-center justify-center rounded-md border border-gray-200 bg-white shadow-sm md:hidden"
        aria-expanded="false"
        aria-controls="main-menu"
        aria-label="Ouvrir le menu">
    <svg id="menuIconOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg id="menuIconClose" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
</button>

<div id="menuBackdrop" class="fixed inset-0 z-[90] hidden bg-black/40 md:hidden"></div>

<nav id="main-menu"
     class="menu fixed inset-y-0 left-0 z-[100] w-[250px] -translate-x-full border-r border-gray-200 bg-white transition-transform duration-300 ease-in-out md:translate-x-0">
    <ul>
        <a href="{{ path('app_home')}}">
            <div class="logo"></div>
        </a>
        <li id="name" class="box-border px-2.5">
            <button id="myBtn">
                <h1 class="caroline" id="openModal">Caroline MARCELLIER</h1>
            </button>
        </li>
        <li class="box-border px-2.5">
            <a class="block h-10 text-lg leading-10 transition-all duration-300 hover:border-b hover:border-gray-300" href="{{ path('preambule') }}" target="_blank">Préambule</a>
        </li>
        {% for category in categories %}
            <li class="box-border px-2.5">
                <a class="block h-10 text-lg leading-10 transition-all duration-300 hover:border-b hover:border-gray-300" href={{ path('app_category_show', {'id': category.id} ) }}>{{ category.titre }}</a>
            </li>
        {% endfor %}
        <li class="box-border px-2.5">
            <a class="block h-10 text-lg leading-10 transition-all duration-300 hover:border-b hover:border-gray-300" href={{ path('contact') }}>Contact</a>
        </li>
    </ul>
</nav>

<script>
// Mobile nav toggle: slides #main-menu in/out below the md breakpoint.
(function () {
    var toggle = document.getElementById('menuToggle');
    var panel = document.getElementById('main-menu');
    var backdrop = document.getElementById('menuBackdrop');
    var iconOpen = document.getElementById('menuIconOpen');
    var iconClose = document.getElementById('menuIconClose');

    function setOpen(isOpen) {
        panel.classList.toggle('-translate-x-full', !isOpen);
        backdrop.classList.toggle('hidden', !isOpen);
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }

    toggle.addEventListener('click', function () {
        setOpen(panel.classList.contains('-translate-x-full'));
    });
    backdrop.addEventListener('click', function () {
        setOpen(false);
    });
})();
</script>

