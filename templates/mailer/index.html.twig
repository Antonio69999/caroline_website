{% extends 'base.html.twig' %}
{% block meta %}
    <meta name="description" content="Caroline MARCELLIER, contact"/>
    <meta name="author" content="Caroline MARCELLIER"/>
{% endblock %}

{% block title %}Caroline MARCELLIER contact
{% endblock %}

{% block body %}
    <section class="narrow-content contact-page">

        {% for message in app.flashes('success') %}
            <div class="alert-success" role="alert">
                {{ message }}
            </div>
        {% endfor %}
        <div class="contact-page__inner">
            <div class="contact-image">
                <img src="{{ asset('asset/images/lapairedechaussure.jpeg') }}" width="650" alt="La paire de chaussures, 2023">
                <p class="credits">La paire de chaussures, 2023</p>
            </div>
            <h1 class="contact-page__title">Contactez-moi :</h1>

            {{ form_start(form) }}
            <div class="contact-form">
                <div class="contact-form__row">
                    <div class="contact-form__field">
                        {{ form_row(form.sujet, {
                            'label': 'Nom',
                            'attr': { 'class': 'contact-form__input' }
                        }) }}
                    </div>
                    <div class="contact-form__field">
                        {{ form_row(form.email, {
                            'label': 'Email',
                            'attr': { 'class': 'contact-form__input' }
                        }) }}
                    </div>
                </div>
                <div class="contact-form__field contact-form__field--full">
                    {{ form_row(form.message, {
                        'label': 'Message',
                        'attr': { 'class': 'contact-form__input contact-form__input--textarea' }
                    }) }}
                </div>
                <div class="contact-form__actions">
                    <button class="btn-primary" type="submit">Envoyer</button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </section>
    <footer class="footer">
        <div class="footer__content">
            <p class="credits">@ 2026 : Les cerveaux derrières les pixels sont
                <a href="https://antoine-portfolio.projets.garage404.com" style="font-weight:bold" target="_blank">Antoine Chabeauti</a>, maître du code et
                <a href="https://www.jeromesauzet.fr" style="font-weight:bold" target="_blank">Jérôme Sauzet</a>, gourou du design à temps plein.
            </p>
            <p class="credits">
                <a href="https://www.instagram.com/rom_cool_k/?hl=fr" style="font-weight:bold" target="_blank">Romain Delrieu,</a>
                habile dessinateur toulousain. N’hésitez pas à les contacter pour les féliciter ou pour la création de votre page web.</p>
        </div>
    </footer>
{% endblock %}
